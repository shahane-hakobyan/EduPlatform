@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    Layout = null;
    ViewData["Title"] = Localizer["Home_PageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var (currentFlagCode, currentLangName) = currentCulture switch
    {
        "ru" => ("ru", "РУС"),
        "en" => ("gb", "ENG"),
        _ => ("am", "ՀԱՅ"),
    };
    var returnUrl = Context.Request.Path.Value;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elearning</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Armenian:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
</head>
<body class="student-page">

    <header class="site-header">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="MainPage">
                <img class="brand-mark" src="~/images/student/logo.png" alt="Elearning" />
            </a>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">@Localizer["Home_NavAbout"]</a>
                <a asp-controller="Home" asp-action="MainPage">@Localizer["Home_NavNews"]</a>
                <a asp-controller="Home" asp-action="Privacy">@Localizer["Home_NavContact"]</a>
            </nav>

            <div class="header-actions">
                <div class="search-box">
                    <input type="search" placeholder="@Localizer["Home_SearchPlaceholder"]" aria-label="@Localizer["Home_SearchAria"]" />
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="6.125" cy="6.125" r="5.104" stroke="#99A1AF" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.7 9.7L12.833 12.833" stroke="#99A1AF" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="lang-dropdown">
                    <button type="button" class="lang-switch" id="langSwitchToggle" aria-haspopup="true" aria-expanded="false">
                        <img class="flag-img" src="~/images/flags/@(currentFlagCode).svg" alt="@currentLangName" />
                        <span class="lang-code">@currentLangName</span>
                    </button>
                    <ul class="lang-dropdown-menu" id="langSwitchMenu">
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="hy" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="lang-switch-item">
                                    <img class="flag-img" src="~/images/flags/am.svg" alt="AM" /> Հայերեն
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="ru" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="lang-switch-item">
                                    <img class="flag-img" src="~/images/flags/ru.svg" alt="RU" /> Русский
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="en" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="lang-switch-item">
                                    <img class="flag-img" src="~/images/flags/gb.svg" alt="GB" /> English
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
                <a href="https://mainlogin.dshh.am:15107/Login/Login" class="login-btn">@Localizer["Home_Login"]</a>
            </div>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <div class="hero-copy">
                <span class="badge-pill">@Localizer["Home_HeroBadge"]</span>
                <h1 class="hero-title">
                    @Localizer["Home_HeroTitle1"]<br />
                    <span class="accent">@Localizer["Home_HeroTitleAccent"]</span> @Localizer["Home_HeroTitle2"]<br />
                    @Localizer["Home_HeroTitle3"]
                </h1>
                <p class="hero-text">
                    @Localizer["Home_HeroText"]
                </p>
                <a href="#library" class="btn-hero">
                    @Localizer["Home_HeroCta"]
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </div>

            <div class="hero-media">
                <img src="~/images/student/hero.png" alt="@Localizer["Home_HeroImgAlt"]" />
                <div class="hero-stat-card">
                    <span class="icon-circle stat-blue">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21V19C16 17.9391 15.5786 16.9217 14.8284 16.1716C14.0783 15.4214 13.0609 15 12 15H6C4.93913 15 3.92172 15.4214 3.17157 16.1716C2.42143 16.9217 2 17.9391 2 19V21"/>
                            <path d="M9 11C11.2091 11 13 9.20914 13 7C13 4.79086 11.2091 3 9 3C6.79086 3 5 4.79086 5 7C5 9.20914 6.79086 11 9 11Z"/>
                            <path d="M22 21V19C21.9993 18.1137 21.7044 17.2528 21.1614 16.5523C20.6184 15.8519 19.8581 15.3516 19 15.13"/>
                            <path d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88"/>
                        </svg>
                    </span>
                    <span class="stat-text">
                        <span class="stat-label">@Localizer["Home_StatLabel"]</span>
                        <strong class="stat-value">10,000+</strong>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-alt" id="library">
        <div class="container">
            <div class="section-heading reveal">
                <h2>@Localizer["Home_LibraryHeading"]</h2>
                <p>
                    @Localizer["Home_LibraryText"]
                </p>
            </div>

            <div class="feature-grid reveal-stagger">
                <div class="feature-card">
                    <span class="icon-circle blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    </span>
                    <h3>@Localizer["Home_Feature1Title"]</h3>
                    <p>@Localizer["Home_Feature1Text"]</p>
                </div>

                <div class="feature-card">
                    <span class="icon-circle green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </span>
                    <h3>@Localizer["Home_Feature2Title"]</h3>
                    <p>@Localizer["Home_Feature2Text"]</p>
                </div>

                <div class="feature-card">
                    <span class="icon-circle purple">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                    </span>
                    <h3>@Localizer["Home_Feature3Title"]</h3>
                    <p>@Localizer["Home_Feature3Text"]</p>
                </div>

                <div class="feature-card">
                    <span class="icon-circle orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </span>
                    <h3>@Localizer["Home_Feature4Title"]</h3>
                    <p>@Localizer["Home_Feature4Text"]</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container split">
            <img class="edu-image reveal" src="~/images/student/library.png" alt="@Localizer["Home_EduImgAlt"]" />

            <div class="split-text reveal">
                <div class="section-heading align-left">
                    <h2 class="edu-heading">@Localizer["Home_EduHeading"]</h2>
                </div>
                <p>
                    @Localizer["Home_EduText"]
                </p>

                <div class="check-grid">
                    <div class="check-item">
                        <span class="check-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8.00004 14.6666C11.6819 14.6666 14.6667 11.6818 14.6667 7.99992C14.6667 4.31802 11.6819 1.33325 8.00004 1.33325C4.31814 1.33325 1.33337 4.31802 1.33337 7.99992C1.33337 11.6818 4.31814 14.6666 8.00004 14.6666Z" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6 8.00008L7.33333 9.33341L10 6.66675" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="check-text">@Localizer["Home_Check1"]</span>
                    </div>
                    <div class="check-item">
                        <span class="check-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8.00004 14.6666C11.6819 14.6666 14.6667 11.6818 14.6667 7.99992C14.6667 4.31802 11.6819 1.33325 8.00004 1.33325C4.31814 1.33325 1.33337 4.31802 1.33337 7.99992C1.33337 11.6818 4.31814 14.6666 8.00004 14.6666Z" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6 8.00008L7.33333 9.33341L10 6.66675" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="check-text">@Localizer["Home_Check2"]</span>
                    </div>
                    <div class="check-item">
                        <span class="check-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8.00004 14.6666C11.6819 14.6666 14.6667 11.6818 14.6667 7.99992C14.6667 4.31802 11.6819 1.33325 8.00004 1.33325C4.31814 1.33325 1.33337 4.31802 1.33337 7.99992C1.33337 11.6818 4.31814 14.6666 8.00004 14.6666Z" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6 8.00008L7.33333 9.33341L10 6.66675" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="check-text">@Localizer["Home_Check3"]</span>
                    </div>
                    <div class="check-item">
                        <span class="check-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8.00004 14.6666C11.6819 14.6666 14.6667 11.6818 14.6667 7.99992C14.6667 4.31802 11.6819 1.33325 8.00004 1.33325C4.31814 1.33325 1.33337 4.31802 1.33337 7.99992C1.33337 11.6818 4.31814 14.6666 8.00004 14.6666Z" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6 8.00008L7.33333 9.33341L10 6.66675" stroke="#2BDFA5" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="check-text">@Localizer["Home_Check4"]</span>
                    </div>
                </div>

                <a href="#" class="btn btn-edu">
                    @Localizer["Home_LearnMore"]
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </div>
        </div>
    </section>

    @{
        var teamSlides = new[]
        {
            new { Title = "Home_TeamHeading", Text = "Home_TeamText", Features = new[] { "Home_MiniFeature1", "Home_MiniFeature2", "Home_MiniFeature3", "Home_MiniFeature4" }, Image = "teamwork.png", Alt = "Home_TeamImgAlt" },
            new { Title = "Home_Slide2Title", Text = "Home_Slide2Text", Features = new[] { "Home_Slide2Feature1", "Home_Slide2Feature2", "Home_Slide2Feature3", "Home_Slide2Feature4" }, Image = "ՈւսումնականԳործընթաց.png", Alt = "Home_Slide2ImgAlt" },
            new { Title = "Home_Slide3Title", Text = "Home_Slide3Text", Features = new[] { "Home_Slide3Feature1", "Home_Slide3Feature2", "Home_Slide3Feature3", "Home_Slide3Feature4" }, Image = "Ակտիվուսուցում.jpg", Alt = "Home_Slide3ImgAlt" },
        };
    }
    <section class="section section-purple team-carousel" id="teamCarousel">
        <div class="team-carousel-bg" aria-hidden="true">
            <svg viewBox="0 0 1440 640" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <line x1="720" y1="0" x2="1440" y2="0" stroke="rgba(255,255,255,0.18)" stroke-width="1" />
                <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
                    <line x1="900" y1="0" x2="900" y2="640" />
                    <line x1="1000" y1="0" x2="1000" y2="640" />
                    <line x1="1100" y1="0" x2="1100" y2="640" />
                    <line x1="1200" y1="0" x2="1200" y2="640" />
                    <line x1="1300" y1="0" x2="1300" y2="640" />
                    <line x1="800" y1="80" x2="1440" y2="80" />
                    <line x1="800" y1="160" x2="1440" y2="160" />
                    <line x1="800" y1="240" x2="1440" y2="240" />
                    <line x1="800" y1="320" x2="1440" y2="320" />
                    <line x1="800" y1="400" x2="1440" y2="400" />
                    <line x1="800" y1="480" x2="1440" y2="480" />
                    <line x1="800" y1="560" x2="1440" y2="560" />
                </g>
                <circle cx="1300" cy="60" r="180" stroke="rgba(255,255,255,0.08)" stroke-width="1" fill="none" />
            </svg>
        </div>

        <div class="container split">
            <div class="split-text reveal">
                <div class="team-carousel-slides">
                    @for (var i = 0; i < teamSlides.Length; i++)
                    {
                        var slide = teamSlides[i];
                        <div class="carousel-slide-content @(i == 0 ? "is-active" : "")" data-slide="@i">
                            <h2>@Localizer[slide.Title]</h2>
                            <p>@Localizer[slide.Text]</p>
                            <div class="mini-feature-grid">
                                @foreach (var feature in slide.Features)
                                {
                                    <span class="mini-feature">
                                        <span class="mini-feature-icon">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M20 13C20 18 16.5 20.5 12.34 21.95C12.1222 22.0238 11.8855 22.0202 11.67 21.94C7.5 20.5 4 18 4 13V5.99996C4 5.73474 4.10536 5.48039 4.29289 5.29285C4.48043 5.10532 4.73478 4.99996 5 4.99996C7 4.99996 9.5 3.79996 11.24 2.27996C11.4519 2.09896 11.7214 1.99951 12 1.99951C12.2786 1.99951 12.5481 2.09896 12.76 2.27996C14.51 3.80996 17 4.99996 19 4.99996C19.2652 4.99996 19.5196 5.10532 19.7071 5.29285C19.8946 5.48039 20 5.73474 20 5.99996V13Z" stroke="#2BDFA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M9 12L11 14L15 10" stroke="#2BDFA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <span class="mini-feature-text">@Localizer[feature]</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="split-actions">
                    <a href="#" class="btn btn-edu-light">
                        @Localizer["Home_ViewDetails"]
                    </a>
                    <span class="slide-nav">
                        <button type="button" class="slide-nav-btn" id="teamPrevBtn" aria-label="@Localizer["Home_PrevSlide"]">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.5 15L7.5 10L12.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <button type="button" class="slide-nav-btn" id="teamNextBtn" aria-label="@Localizer["Home_NextSlide"]">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 15L12.5 10L7.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </span>
                </div>
            </div>

            <div class="team-carousel-media">
                @for (var i = 0; i < teamSlides.Length; i++)
                {
                    var slide = teamSlides[i];
                    <img class="teamwork-image carousel-slide-img @(i == 0 ? "is-active" : "")" data-slide="@i" src="~/images/student/@(slide.Image)" alt="@Localizer[slide.Alt]" />
                }
            </div>
        </div>

        <div class="container">
            <div class="carousel-dots" id="teamDots">
                @for (var i = 0; i < teamSlides.Length; i++)
                {
                    <span class="@(i == 0 ? "active" : "")" data-slide="@i"></span>
                }
            </div>
        </div>
    </section>

    <section class="section section-books">
        <div class="container">
            <div class="books-header reveal">
                <div class="books-header-text">
                    <h2 class="books-heading">@Localizer["Home_BooksHeading"]</h2>
                    <span class="books-heading-bar"></span>
                    <p class="books-desc">@Localizer["Home_BooksDesc"]</p>
                </div>
                <a href="#" class="btn-books-all">
                    <span class="btn-books-all-text">@Localizer["Home_AllBooks"]</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.16663 10H15.8333" stroke="#6369D4" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M10 4.16675L15.8333 10.0001L10 15.8334" stroke="#6369D4" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>

            <div class="books-grid reveal-stagger">
                <div class="book-card">
                    <div class="book-cover book-cover-art">
                        <span class="book-badge">@Localizer["Home_Book1Badge"]</span>
                        <a href="#" class="book-cta">@Localizer["Home_ReadCta"]</a>
                    </div>
                    <h3 class="book-title">@Localizer["Home_Book1Title"]</h3>
                    <p class="book-author">@Localizer["Home_Book1Author"]</p>
                </div>
                <div class="book-card">
                    <div class="book-cover">
                        <img src="~/images/student/book-space.svg" alt="@Localizer["Home_Book2Title"]" />
                        <span class="book-badge">@Localizer["Home_Book2Badge"]</span>
                        <a href="#" class="book-cta">@Localizer["Home_ReadCta"]</a>
                    </div>
                    <h3 class="book-title">@Localizer["Home_Book2Title"]</h3>
                    <p class="book-author">@Localizer["Home_Book2Author"]</p>
                </div>
                <div class="book-card">
                    <div class="book-cover">
                        <img src="~/images/student/book-history.svg" alt="@Localizer["Home_Book3Title"]" />
                        <span class="book-badge">@Localizer["Home_Book3Badge"]</span>
                        <a href="#" class="book-cta">@Localizer["Home_ReadCta"]</a>
                    </div>
                    <h3 class="book-title">@Localizer["Home_Book3Title"]</h3>
                    <p class="book-author">@Localizer["Home_Book3Author"]</p>
                </div>
                <div class="book-card">
                    <div class="book-cover book-cover-biology">
                        <span class="book-badge">@Localizer["Home_Book4Badge"]</span>
                        <a href="#" class="book-cta">@Localizer["Home_ReadCta"]</a>
                    </div>
                    <h3 class="book-title">@Localizer["Home_Book4Title"]</h3>
                    <p class="book-author">@Localizer["Home_Book4Author"]</p>
                </div>
                <div class="book-card">
                    <div class="book-cover book-cover-math">
                        <span class="book-badge">@Localizer["Home_Book5Badge"]</span>
                        <a href="#" class="book-cta">@Localizer["Home_ReadCta"]</a>
                    </div>
                    <h3 class="book-title">@Localizer["Home_Book5Title"]</h3>
                    <p class="book-author">@Localizer["Home_Book5Author"]</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-cta">
        <div class="container">
            <div class="cta-banner reveal">
