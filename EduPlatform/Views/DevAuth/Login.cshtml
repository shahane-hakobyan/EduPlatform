@{
    Layout = null;
    ViewData["Title"] = "Dev Login";
}
<div style="max-width:420px;margin:80px auto;font-family:sans-serif;text-align:center;">
    <h2>EduPlatform — Dev Login</h2>
    <p>Development-only stand-in for AuthServer login. Pick a role to sign in as a fixed test user.</p>

    <form method="post" action="/Dev/LoginAsTeacher" style="margin-bottom:12px;">
        <button type="submit" style="width:100%;padding:10px;">Log in as Teacher</button>
    </form>

    <form method="post" action="/Dev/LoginAsPupil">
        <button type="submit" style="width:100%;padding:10px;">Log in as Pupil</button>
    </form>
</div>