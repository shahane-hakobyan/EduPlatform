@model EduPlatform.ViewModels.MaterialsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div class="materials-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="materials-search position-relative flex-grow-1">
        <i class="bi bi-search materials-search-icon"></i>
        <input type="text" class="materials-search-input" placeholder="@Localizer["Search"]" />
    </div>
    @foreach (var filter in Model.Filters)
    {
        <select class="materials-filter-select" data-filter-key="@filter.Key">
            <option value="">@filter.Label</option>
        </select>
    }
</div>

<div class="d-flex justify-content-end mb-3">
    <div class="materials-view-toggle btn-group" role="group">
        <button type="button" class="btn materials-view-btn active" data-view="grid">
            <i class="bi bi-grid-3x3-gap"></i> @Localizer["Grid"]
        </button>
        <button type="button" class="btn materials-view-btn" data-view="list">
            <i class="bi bi-list-ul"></i> @Localizer["ListView"]
        </button>
    </div>
</div>

<div class="materials-grid">
    @foreach (var material in Model.Materials)
    {
        <partial name="~/Views/Shared/Materials/_MaterialCard.cshtml" model="material" />
    }
</div>

<div class="materials-list-view" style="display:none;">
    <table class="materials-table">
        <thead>
            <tr>
                <th>@Localizer["Material"]</th>
                @if (Model.Filters.Any(f => f.Key == "subject"))
                {
                    <th>@Localizer["Subject"]</th>
                }
                <th>@Localizer["Author"]</th>
                @if (Model.Filters.Any(f => f.Key == "grade"))
                {
                    <th>@Localizer["Grade"]</th>
                }
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var material in Model.Materials)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="materials-table-icon cover-@material.ColorVariant">
                                @if (!string.IsNullOrEmpty(material.ThumbnailUrl))
                                {
                                    <img src="@material.ThumbnailUrl" alt="@string.Join(", ", material.Subjects)" />
                                }
                                else
                                {

                                    <i class="bi bi-tablet"></i>
                                }
                            </div>
                            <div>
                                <div class="materials-table-title">@string.Join(", ", material.Subjects)</div>
                                <div class="materials-table-sub">@material.Year &middot; @material.Pages @Localizer["Pages"]</div>
                            </div>
                        </div>
                    </td>
                    @if (Model.Filters.Any(f => f.Key == "subject"))
                    {
                        <td><span class="materials-table-chip">@string.Join(", ", material.Subjects)</span></td>
                    }
                    <td class="materials-table-author">@material.Authors</td>
                    @if (Model.Filters.Any(f => f.Key == "grade"))
                    {
                        <td>@string.Join(", ", material.Grades)</td>
                    }
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <a href="@material.ViewUrl" class="material-card-view-btn d-flex align-items-center justify-content-center gap-2" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-eye"></i> @Localizer["View"]
                            </a>
                            <a href="@material.DownloadUrl" download class="material-card-download-btn d-flex align-items-center justify-content-center">
                                <i class="bi bi-download"></i>
                            </a>
                            <button type="button" class="material-card-delete-btn d-flex align-items-center justify-content-center" data-material-id="@material.Id" data-confirm-text="@Localizer["ConfirmDeleteMaterial"]" title="@Localizer["Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Materials.Any())
{
    <div class="materials-empty text-center py-5">
        <i class="bi bi-inbox materials-empty-icon"></i>
        <p class="materials-empty-text">@Localizer["NoMaterialsSaved"]</p>
    </div>
}