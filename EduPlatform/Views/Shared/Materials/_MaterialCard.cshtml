@model EduPlatform.ViewModels.MaterialCardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div class="material-card-wide">
    <div class="material-card-wide-image material-card-cover" data-full-image="@Model.ThumbnailUrl">
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <img src="@Model.ThumbnailUrl" alt="@string.Join(", ", Model.Subjects)" />
        }
        else
        {
            <div class="material-card-wide-placeholder cover-@Model.ColorVariant">
                <i class="bi bi-tablet material-card-placeholder-icon"></i>
                <span class="material-card-cover-decor"></span>
                <span class="material-card-grade-pill">@string.Join(", ", Model.Grades)</span>
                <span class="material-card-cover-title">@string.Join(", ", Model.Subjects)</span>
            </div>
        }
    </div>

    <div class="material-card-wide-content">
        @if (Model.Subjects.Any())
        {
            <span class="material-card-subject-chip" data-bs-toggle="tooltip" data-bs-placement="top" title="@string.Join(", ", Model.Subjects)">@string.Join(", ", Model.Subjects)</span>
        }
        else if (!string.IsNullOrEmpty(Model.Language))
        {
            <span class="material-card-subject-chip">@Model.Language</span>
        }
        <p class="material-card-wide-authors" data-bs-toggle="tooltip" data-bs-placement="top" title="@Model.Authors">@Model.Authors</p>
        <p class="material-card-wide-publisher">@Model.Publisher</p>

        <div class="material-card-wide-meta d-flex align-items-center gap-3">
            @if (Model.Grades.Any())
            {
                <span><i class="bi bi-mortarboard-fill"></i> @string.Join(", ", Model.Grades)</span>
            }
            <span><i class="bi bi-calendar3"></i> @Model.Year</span>
            <span><i class="bi bi-file-earmark-text"></i> @Model.Pages @Localizer["Pages"]</span>
        </div>

        <div class="material-card-actions">
            <a href="@Model.ViewUrl" class="material-card-view-btn d-flex align-items-center justify-content-center gap-2" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-eye"></i> @Localizer["View"]
            </a>
            <a href="@Model.DownloadUrl" download class="material-card-download-btn d-flex align-items-center justify-content-center">
                <i class="bi bi-download"></i>
            </a>
            <button type="button" class="material-card-delete-btn d-flex align-items-center justify-content-center" data-material-id="@Model.Id" data-confirm-text="@Localizer["ConfirmDeleteMaterial"]" title="@Localizer["Delete"]">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>
</div>