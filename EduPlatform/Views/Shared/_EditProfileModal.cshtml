@model EduPlatform.ViewModels.TeacherProfileViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div id="editProfileBackdrop" class="edit-profile-backdrop"></div>
<div id="editProfileModal" class="edit-profile-modal">
    <div class="edit-profile-header">
        <button type="button" id="editProfileCloseBtn" class="edit-profile-back-btn" aria-label="@Localizer["Close"]">
            <i class="bi bi-arrow-left"></i>
        </button>
        <h2 class="edit-profile-title mb-0">@Localizer["PersonalInformation"]</h2>
    </div>

    <div class="edit-profile-body">
        <div class="edit-profile-avatar-wrap">
            <div class="position-relative d-inline-block">
                <div class="edit-profile-avatar" id="editProfileAvatarPreview" style="background-image:url('@Model.PhotoUrl')"></div>
                <button type="button" id="editProfileDeletePhotoBtn" class="edit-profile-avatar-delete-badge" aria-label="@Localizer["DeletePhoto"]">
                    <i class="bi bi-trash-fill"></i>
                </button>
            </div>
            <button type="button" id="editProfileAddPhotoBtn" class="edit-profile-photo-btn">@Localizer["AddPhoto"]</button>
            <input type="file" id="editProfilePhotoInput" accept="image/*" hidden />
        </div>

        <h3 class="edit-profile-section-title">@Localizer["PersonalInformation"]</h3>

        <form id="editProfileForm" class="edit-profile-card">
            <div>
                <label class="edit-profile-field-label">@Localizer["FullName"]</label>
                <input type="text" class="edit-profile-input" value="@Model.FullName" readonly />
            </div>

            <div>
                <label class="edit-profile-field-label">@Localizer["Email"]</label>
                <input type="email" class="edit-profile-input" value="@Model.Email" readonly />
            </div>

            <div>
                <label class="edit-profile-field-label">@Localizer["PhoneNumber"]</label>
                <input type="tel" name="phoneNumber" class="edit-profile-input" value="@Model.PhoneNumber" />
            </div>

            <div>
                <label class="edit-profile-field-label">@Localizer["DigitLevel"]</label>
                <input type="text" class="edit-profile-input" value="@Model.DigitLevel" readonly />
            </div>

            <div>
                <label class="edit-profile-field-label">@Localizer["VoluntaryCertification"]</label>
                <input type="text" name="voluntaryCertification" class="edit-profile-input" value="@Model.VoluntaryCertification" />
            </div>

            <div>
                <label class="edit-profile-field-label">@Localizer["ProfessionalAchievements"]</label>
                <textarea name="professionalAchievements" class="edit-profile-input edit-profile-textarea">@Model.ProfessionalAchievements</textarea>
            </div>

            <div class="edit-profile-actions">
                <button type="button" id="editProfileCancelBtn" class="edit-profile-cancel-btn">@Localizer["Cancel"]</button>
                <button type="submit" class="edit-profile-save-btn">@Localizer["Save"]</button>
            </div>
        </form>
    </div>
</div>