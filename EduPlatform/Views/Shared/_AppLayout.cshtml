@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
<!DOCTYPE html>
<html lang="hy">
<head>
    <script>
            (function () {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduPlatform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Armenian:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/typography.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="~/css/app-header.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value;
        if (string.IsNullOrEmpty(currentPath) || currentPath == "/") currentPath = "/Teacher";
        var sidebarItems = ViewBag.SidebarItems as List<SidebarMenuItem> ?? new();
        var sidebarFooterItems = ViewBag.SidebarFooterItems as List<SidebarMenuItem> ?? new();

        // էջի վերնագիրը՝ մենյուի ցանկացած խորության տարրից (մինչև ներդրված ենթաբաժինները)
        static string? FindTitle(IEnumerable<SidebarMenuItem> items, string? path)
        {
            foreach (var item in items)
            {
                if (item.Url == path) return item.Label;
                var found = FindTitle(item.Children, path);
                if (found != null) return found;
            }
            return null;
        }
        string pageTitle = FindTitle(sidebarItems, currentPath) ?? "";
    }

    <div class="d-flex">
        @await Component.InvokeAsync("SidebarMenu", new { items = sidebarItems, footerItems = sidebarFooterItems, userIp = Context.Connection.RemoteIpAddress?.ToString() })

        <div class="d-flex flex-column flex-grow-1">
            <header class="app-header d-flex align-items-center justify-content-between">
                <h1 class="app-header-title mb-0">@pageTitle</h1>

                <div class="app-header-actions d-flex align-items-center gap-4">

                    <div class="app-search position-relative">
                        <i class="bi bi-search app-search-icon"></i>
                        <input type="text" class="app-search-input" placeholder="@Localizer["Search"]" />
                    </div>

                    <button type="button" class="app-icon-btn position-relative" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="app-notification-dot"></span>
                    </button>

                    <div class="app-avatar"></div>

                    <div class="app-datetime text-end">
                        <div class="app-time" id="appClockTime">--:-- --</div>
                        <div class="app-date" id="appClockDate">--.--.----</div>
                    </div>

                    <a href="@Url.Action("MainPage", "Home")" class="app-view-website-btn pill-surface" aria-label="@Localizer["BackToSite"]">
                        <span class="app-view-website-dot"></span>
                        <i class="bi bi-globe2 app-view-website-icon"></i>
                        <span class="app-view-website-label">@Localizer["BackToSite"]</span>
                        <i class="bi bi-arrow-right app-view-website-arrow"></i>
                    </a>

                    <button type="button" class="app-icon-btn app-icon-btn-pill pill-surface app-theme-toggle" id="themeToggleBtn" aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i>
                        <i class="bi bi-sun"></i>
                    </button>

                    <partial name="_LanguageSwitcher" />
                </div>
            </header>

            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar.js"></script>
    <script src="~/js/app-header.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>