@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
<!DOCTYPE html>
<html lang="hy">
<head>
    <script>
            (function () {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduPlatform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Armenian:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/typography.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="~/css/app-header.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value;
        if (string.IsNullOrEmpty(currentPath) || currentPath == "/") currentPath = "/Teacher";
        var sidebarItems = ViewBag.SidebarItems as List<EduPlatform.Models.SidebarMenuItem> ?? new();
        var sidebarFooterItems = ViewBag.SidebarFooterItems as List<SidebarMenuItem> ?? new();

        string pageTitle = "";
        foreach (var item in sidebarItems)
        {
            if (item.Url == currentPath) { pageTitle = item.Label; break; }
            var child = item.Children.FirstOrDefault(c => c.Url == currentPath);
            if (child != null) { pageTitle = child.Label; break; }
        }
    }

    <div class="d-flex">
        @await Component.InvokeAsync("SidebarMenu", new { items = sidebarItems, footerItems = sidebarFooterItems, userIp = Context.Connection.RemoteIpAddress?.ToString() })

        <div class="d-flex flex-column flex-grow-1">
            <header class="app-header d-flex align-items-center justify-content-between">
                <h1 class="app-header-title mb-0">@pageTitle</h1>

                <div class="app-header-actions d-flex align-items-center gap-4">
                    <button type="button" class="app-icon-btn app-theme-toggle" id="themeToggleBtn" aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i>
                        <i class="bi bi-sun"></i>
                    </button>

                    <a href="@Url.Action("Index", "Home")" class="app-icon-btn text-decoration-none" aria-label="@Localizer["BackToSite"]" title="@Localizer["BackToSite"]">
                        <i class="bi bi-house-door"></i>
                    </a>

                    <div class="app-search position-relative">
                        <i class="bi bi-search app-search-icon"></i>
                        <input type="text" class="app-search-input" placeholder="@Localizer["Search"]" />
                    </div>

                    <button type="button" class="app-icon-btn position-relative" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="app-notification-dot"></span>
                    </button>

                    <div class="app-avatar"></div>

                    <div class="app-datetime text-end">
                        <div class="app-time" id="appClockTime">--:-- --</div>
                        <div class="app-date" id="appClockDate">--.--.----</div>
                    </div>

                    <partial name="_LanguageSwitcher" />
                </div>
            </header>

            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar.js"></script>
    <script src="~/js/app-header.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>