@model List<SidebarMenuItem>
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/Profile";
    var footerItems = (List<SidebarMenuItem>)ViewBag.FooterItems;

    // Ընթացիկ էջին համապատասխանող մենյուի կետը՝ ամենաերկար համընկնող հղումը։
    // Օրինակ՝ /Repository/Assignments/Create և /Repository/Assignments/5 → «Տրված առաջադրանքներ»,
    // /Repository/Assignments/Bank/12/Send → «Առաջադրանքների շտեմարան», /Groups/3 → «Խմբեր»։
    static IEnumerable<SidebarMenuItem> Flatten(IEnumerable<SidebarMenuItem> items) =>
        items.SelectMany(i => new[] { i }.Concat(Flatten(i.Children)));

    bool Matches(string? url) =>
        !string.IsNullOrEmpty(url) && url != "#"
        && (currentPath.Equals(url, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(url.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase));

    var activeUrl = Flatten(Model).Concat(Flatten(footerItems))
        .Select(i => i.Url)
        .Where(Matches)
        .OrderByDescending(u => u!.Length)
        .FirstOrDefault();

    bool IsActiveUrl(string? url) => activeUrl != null && string.Equals(url, activeUrl, StringComparison.OrdinalIgnoreCase);
    bool HasActive(SidebarMenuItem item) => item.Children.Any(c => IsActiveUrl(c.Url) || HasActive(c));
}

<aside class="sidebar d-flex flex-column bg-light" id="sidebar">

    <div class="sidebar-topbar d-flex align-items-center gap-2 px-3 py-2">
        <img src="~/images/flags/@(ViewBag.CountryCode).svg" class="sidebar-flag" alt="@ViewBag.CountryCode" />
        <span class="sidebar-ip">IP: @ViewBag.UserIp</span>
    </div>

    <div class="sidebar-brand text-center">
        <a href="https://dshh.am/am" target="_blank" rel="noopener noreferrer">
            <img src="~/images/logo.png" class="sidebar-logo" alt="Textbook and ICT Revolving Fund" />
        </a>
    </div>

    <ul class="list-unstyled flex-grow-1 mb-0">
        @foreach (var item in Model)
        {
            var hasActiveChild = HasActive(item);
            <li class="sidebar-item position-relative @(hasActiveChild ? "open" : "")">
                <a href="@(item.Url ?? "#")" class="sidebar-link d-flex align-items-center gap-3 px-3 py-2 text-decoration-none text-nowrap @((IsActiveUrl(item.Url) || hasActiveChild) ? "active" : "")">
                    @Html.Raw(item.IconSvg)
                    <span class="sidebar-label">@item.Label</span>
                    @if (item.Children.Any())
                    {
                        <i class="bi bi-chevron-down sidebar-caret ms-auto"></i>
                    }
                </a>

                @if (!item.Children.Any())
                {
                    <span class="sidebar-tooltip">@item.Label</span>
                }

                @if (item.Children.Any())
                {
                    <ul class="sidebar-submenu list-unstyled ps-4">
                        <li class="sidebar-submenu-header">@item.Label</li>
                        @foreach (var child in item.Children)
                        {
                            var childHasActive = HasActive(child);

                            if (child.Children.Any())
                            {
                                <li class="sidebar-subitem @(childHasActive ? "open" : "")">
                                    <a href="#" class="sidebar-sublink d-flex align-items-center gap-2 py-2 text-decoration-none">
                                        @Html.Raw(child.IconSvg)
                                        <span>@child.Label</span>
                                        <i class="bi bi-chevron-down sidebar-subcaret ms-auto"></i>
                                    </a>
                                    <ul class="sidebar-submenu-nested list-unstyled">
                                        @foreach (var grand in child.Children)
                                        {
                                            <li>
                                                <a href="@grand.Url" class="d-flex align-items-center gap-2 py-2 text-decoration-none @(IsActiveUrl(grand.Url) ? "active" : "")">
                                                    @Html.Raw(grand.IconSvg)
                                                    <span>@grand.Label</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a href="@child.Url" class="d-flex align-items-center gap-2 py-2 text-decoration-none @(IsActiveUrl(child.Url) ? "active" : "")">
                                        @Html.Raw(child.IconSvg)
                                        <span>@child.Label</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                }
            </li>
        }
    </ul>

    <ul class="sidebar-footer-menu list-unstyled mb-0">
        @foreach (var item in footerItems)
        {
            <li class="sidebar-item position-relative">
                <a href="@(item.Url ?? "#")" class="sidebar-link d-flex align-items-center gap-3 px-3 py-2 text-decoration-none text-nowrap @(IsActiveUrl(item.Url) ? "active" : "")">
                    @Html.Raw(item.IconSvg)
                    <span class="sidebar-label">@item.Label</span>
                </a>
                <span class="sidebar-tooltip">@item.Label</span>
            </li>
        }
    </ul>

    <button type="button" class="btn btn-primary sidebar-toggle-btn m-3" id="sidebarToggle" aria-label="Toggle menu">
        <i class="bi bi-chevron-left"></i>
        <span class="sidebar-toggle-label">@Localizer["Close"]</span>
    </button>
</aside>