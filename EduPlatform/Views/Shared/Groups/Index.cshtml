@model EduPlatform.ViewModels.GroupsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Groups"].Value;
    var uid = Guid.NewGuid().ToString("N")[..6];
}

<div class="assignments-header d-flex align-items-start justify-content-between mb-3">
    <div>
        <h1 class="materials-title mb-1">@Localizer["Groups"]</h1>
        <p class="tools-subtitle mb-0"><span id="groupsCount">@Model.Groups.Count</span> @Localizer["GroupsCountLabel"]</p>
    </div>
    <a href="@Model.CreateUrl" class="assignments-create-btn d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> @Localizer["CreateGroup"]
    </a>
</div>

<div class="assignments-tabs-row mb-3">
    <button type="button" class="assignment-tab-btn active">
        @Localizer["MyGroupsTab"]
    </button>
</div>

<div class="materials-filter-bar mb-3">
    <div class="materials-search position-relative">
        <i class="bi bi-search materials-search-icon"></i>
        <input type="text" class="materials-search-input materials-search-input-full" placeholder="@Localizer["SearchGroups"]" />
    </div>
    <div class="materials-filter-row d-flex flex-wrap align-items-center gap-2">
        @foreach (var filter in Model.Filters)
        {
            <div class="dropdown materials-filter-dropdown" data-filter-key="@filter.Key">
                <button class="btn materials-filter-select dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    @filter.Label
                    <span class="materials-filter-badge" style="display:none">0</span>
                </button>
                <div class="dropdown-menu materials-filter-menu">
                    <div class="materials-filter-menu-head">
                        <a href="#" class="materials-filter-clear-one" style="display:none">
                            <i class="bi bi-x-circle"></i> @Localizer["ClearThisFilter"]
                        </a>
                    </div>
                    @for (var i = 0; i < filter.Options.Count; i++)
                    {
                        var inputId = $"f-{uid}-{filter.Key}-{i}";
                        <input type="checkbox" class="materials-filter-pill-input" value="@filter.Options[i]" id="@inputId" />
                        <label class="materials-filter-pill" for="@inputId">@filter.Options[i]</label>
                    }
                </div>
            </div>
        }
        <button type="button" class="materials-filter-apply-btn">@Localizer["Apply"]</button>
        <a href="#" class="materials-filter-clear-btn" style="display:none">
            <i class="bi bi-x-circle"></i> @Localizer["ClearFilters"]
        </a>
    </div>
</div>

@if (!Model.Groups.Any())
{
    <div class="materials-empty text-center py-5">
        <i class="bi bi-people materials-empty-icon"></i>
        <p class="materials-empty-text">@Localizer["NoGroups"]</p>
    </div>
}
else
{
    <div class="groups-grid">
        @foreach (var g in Model.Groups)
        {
            <a class="group-card" href="@g.DetailUrl"
               data-f-type="@g.TypeLabel"
               data-f-role="@g.RoleLabel"
               data-f-search="@g.Name.ToLowerInvariant()">
                <div class="group-card-avatar">
                    @if (!string.IsNullOrEmpty(g.ImageUrl))
                    {
                        <img src="@g.ImageUrl" alt="" />
                    }
                    else
                    {
                        <i class="bi bi-people"></i>
                    }
                </div>
                <div class="group-card-body">
                    <div class="group-card-title" title="@g.Name">@g.Name</div>
                    <div class="group-card-tags">
                        <span class="group-tag group-tag-@g.TypeKey.ToLowerInvariant()">@g.TypeLabel</span>
                        <span class="group-tag group-tag-role @(g.IsAdmin ? "is-admin" : "is-member")" title="@g.RoleLabel">@g.RoleShortLabel</span>
                    </div>
                    <div class="group-card-foot">
                        <span class="group-card-preview"></span>
                        <span class="group-card-members" title="@Localizer["MembersCountLabel"]">
                            <i class="bi bi-people"></i> @g.MemberCount
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/library/materials.css" />
    <link rel="stylesheet" href="~/css/common/filter-bar.css" />
    <link rel="stylesheet" href="~/css/assignments/assignments.css" />
    <link rel="stylesheet" href="~/css/groups/groups.css" />
}
@section Scripts {
    <script src="~/js/common/filter-bar.js"></script>
    <script src="~/js/groups/groups.js"></script>
}
