@model EduPlatform.ViewModels.AssignmentBankCardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div class="bank-row" data-assignment-id="@Model.Id"
     data-f-subject="@string.Join("|", Model.SubjectList)"
     data-f-grade="@string.Join("|", Model.GradeList)"
     data-f-type="@string.Join("|", Model.TypeList)"
     data-f-gradingtype="@Model.GradingType"
     data-f-created="@Model.CreatedAt.ToString("dd.MM.yyyy")"
     data-f-search="@((Model.Title + " " + Model.Subject).ToLowerInvariant())">
    <div class="bank-row-icon"><i class="bi bi-file-earmark-text"></i></div>

    <div class="bank-row-main">
        <div class="bank-row-title" title="@Model.Title">@Model.Title</div>
        <div class="bank-row-tags">
            @foreach (var s in Model.SubjectList)
            {
                <span class="bank-tag">@s</span>
            }
            @foreach (var g in Model.GradeList)
            {
                <span class="bank-tag">@g</span>
            }
            @foreach (var t in Model.TypeList)
            {
                <span class="bank-tag">@t</span>
            }
            @if (!string.IsNullOrEmpty(Model.GradingType))
            {
                <span class="bank-tag">@Model.GradingType</span>
            }
        </div>
    </div>

    <div class="bank-row-meta">
        <div><i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("dd.MM.yyyy")</div>
        <div><i class="bi bi-clock"></i> @Model.SentCount @Localizer["TimesSuffix"]</div>
    </div>

    <div class="bank-row-actions">
        <a href="@Url.Action("Create", "Assignments", new { fromTemplate = Model.Id })" class="bank-btn bank-btn-send" title="@Localizer["SendAssignmentBtn"]">
            <i class="bi bi-send"></i>
        </a>
        <a href="@Url.Action("BankEdit", "Assignments", new { id = Model.Id })" class="bank-btn" title="@Localizer["Edit"]"><i class="bi bi-pencil"></i></a>
        <a href="@Url.Action("BankView", "Assignments", new { id = Model.Id })" class="bank-btn" title="@Localizer["View"]"><i class="bi bi-eye"></i></a>
        <button type="button" class="bank-btn bank-btn-delete" data-bank-delete data-assignment-id="@Model.Id"
                data-confirm-text="@Localizer["ConfirmDeleteBankAssignment"]" title="@Localizer["Remove"]">
            <i class="bi bi-trash"></i>
        </button>
    </div>
</div>
