@model EduPlatform.ViewModels.AssignmentDetailViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div id="addPupilsModal-backdrop" class="answer-modal-backdrop"></div>
<div id="addPupilsModal" class="answer-modal">
    <div class="answer-modal-header">
        <div class="answer-modal-name">@Localizer["AddPupilsTitle"]</div>
        <button type="button" class="answer-modal-close" data-close-modal="addPupilsModal">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="answer-modal-body">
        <div class="ca-group-tabs mb-2">
            <button type="button" class="ca-group-tab active" data-add-tab="classes">@Localizer["MyClassesTab"]</button>
            <button type="button" class="ca-group-tab" data-add-tab="groups">@Localizer["MyGroupsTab"]</button>
        </div>

        <div class="ca-selected-summary d-flex align-items-center justify-content-between">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle"></i>
                <span id="addPupilsSelectedCount">0</span> @Localizer["SelectedPupilsSuffix"]
            </span>
            <button type="button" class="ca-clear-btn" id="addPupilsClearAllBtn">@Localizer["ClearAllLabel"]</button>
        </div>

        <div class="ca-pupil-search position-relative mt-2">
            <i class="bi bi-search"></i>
            <input type="text" id="addPupilsSearch" placeholder="@Localizer["SearchPupilPlaceholder"]" />
        </div>

        <div class="ca-groups-pane mt-2" id="addPupilsGroupsPane" style="display:none">
            <partial name="Form/_GroupPicker" model="Model.Groups" />
        </div>

        <div class="ca-class-groups mt-2" id="addPupilsClassesPane">
            @foreach (var group in Model.AvailableGrades)
            {
                // միայն դեռ չավելացված սովորողները (արդեն ավելացվածները չեն հաշվվում)
                var addableCount = group.Pupils.Count(p => !Model.AlreadyAddedPupilUserIds.Contains(p.UserId));
                <div class="ca-class-group" data-grade-id="@group.GradeId">
                    <button type="button" class="ca-class-group-head">
                        <span class="d-flex align-items-center gap-2">
                            <span class="ca-class-icon"><i class="bi bi-people"></i></span>
                            <span class="ca-class-name">@group.GradeName</span>
                            <span class="ca-class-selected-badge" data-selected-badge>0</span>
                        </span>
                        <span class="d-flex align-items-center gap-2">
                            <span class="ca-class-count">@group.Pupils.Count @Localizer["PupilsCountSuffix"]</span>
                            <i class="bi bi-chevron-down ca-class-caret"></i>
                        </span>
                    </button>
                    <div class="ca-class-group-body">
                        <div class="ca-class-group-toolbar">
                            <button type="button" class="ca-select-all-btn" @(addableCount == 0 ? "disabled" : "")><i class="bi bi-check2-all"></i> @Localizer["SelectAllLabel"]</button>
                            <span class="ca-class-progress" data-progress-label>0 / @addableCount</span>
                        </div>
                        <div class="ca-pupil-grid">
                            @foreach (var pupil in group.Pupils)
                            {
                                var alreadyAdded = Model.AlreadyAddedPupilUserIds.Contains(pupil.UserId);
                                <label class="ca-pupil-item @(alreadyAdded ? "ca-pupil-item-disabled" : "")">
                                    <input type="checkbox" data-pupil-checkbox value="@pupil.UserId" @(alreadyAdded ? "checked disabled" : "") />
                                    <img src="@pupil.PhotoUrl" alt="" class="ca-pupil-avatar" />
                                    <span class="ca-pupil-check"><i class="bi bi-check"></i></span>
                                    <span class="ca-pupil-name">
                                        @if (!string.IsNullOrEmpty(pupil.ProfileUrl))
                                        {
                                            <a href="@pupil.ProfileUrl" target="_blank" rel="noopener" onclick="event.stopPropagation()">@pupil.Name</a>
                                        }
                                        else
                                        {
                                            @pupil.Name
                                        }
                                    </span>
                                    @if (alreadyAdded)
                                    {
                                        <span class="ca-pupil-already-badge">@Localizer["AlreadyAddedLabel"]</span>
                                    }
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="answer-modal-footer">
        <button type="button" class="answer-cancel-btn" data-close-modal="addPupilsModal">@Localizer["CancelBtn"]</button>
        <button type="button" class="answer-save-btn" id="addPupilsSubmitBtn" disabled>
            <i class="bi bi-person-plus"></i> @Localizer["AddSelectedBtn"]
        </button>
    </div>
</div>