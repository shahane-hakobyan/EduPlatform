@model EduPlatform.ViewModels.SendAssignmentViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    var a = Model.Assignment;
    var pupilPicker = new EduPlatform.ViewModels.PupilPickerViewModel
    {
        ClassGroups = Model.ClassGroups,
        Groups = Model.Groups,
        SelectedIds = Model.PupilIds,
        FieldName = "PupilIds"
    };
    ViewData["Title"] = Localizer["SendAssignmentTitle"].Value;
    ViewData["HeaderTitle"] = Localizer["AssignmentBank"].Value;   // title in the top app header
}

<form id="createAssignmentForm" method="post" action="@Model.SubmitUrl" class="create-assignment-page ca-redesign" data-mode="SendOnly">
    <div class="ca-topbar">
        <a href="@Model.CancelUrl" class="ca-back-btn d-flex align-items-center justify-content-center">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <h1 class="ca-title mb-0">@Localizer["SendAssignmentTitle"]</h1>
            <p class="ca-subtitle mb-0">@Localizer["SendAssignmentSubtitle"]</p>
        </div>
        <span class="ca-selected-badge d-flex align-items-center gap-2" id="caSelectedBadgeTop">
            <i class="bi bi-people"></i> <span id="caSelectedCountTop">0</span> @Localizer["SelectedPupilsSuffix"]
        </span>
    </div>

    <div class="ca-container">

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="ca-error">@Model.Error</div>
        }
        <div class="ca-error" id="caClientError" style="display:none"
             data-default-msg="@Localizer["AssignmentFormIncomplete"]"
             data-date-msg="@Localizer["DeadlineInvalid"]">
            @Localizer["AssignmentFormIncomplete"]
        </div>

        <!-- Ընտրված առաջադրանքը՝ միայն դիտում -->
        <div class="ad-card mb-3">
            <div class="ad-card-head">
                <i class="bi bi-file-earmark-text"></i>
                <h2 class="ad-card-title">@a.Title</h2>
            </div>
            <div class="ad-card-body">
                <div class="ad-info-grid">
                    <div>
                        <div class="ad-info-label">@Localizer["Subject"]</div>
                        <div class="ad-info-value">@a.Subject</div>
                    </div>
                    <div>
                        <div class="ad-info-label">@Localizer["Grade"]</div>
                        <div class="ad-info-value">@a.Grade</div>
                    </div>
                    <div>
                        <div class="ad-info-label">@Localizer["AssignmentType"]</div>
                        <div class="ad-info-value">@a.Type</div>
                    </div>
                    <div>
                        <div class="ad-info-label">@Localizer["Evaluation"]</div>
                        <div class="ad-info-value">@a.GradingType</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(a.Description) || !string.IsNullOrWhiteSpace(a.TaskText) || a.Files.Any())
                {
                    <div class="ad-description-box mt-3">
                        @if (!string.IsNullOrWhiteSpace(a.Description))
                        {
                            <div>@a.Description</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(a.TaskText))
                        {
                            <div class="ad-files-title">@Localizer["AssignmentTaskLabel"]</div>
                            <div class="ad-task-text">@a.TaskText</div>
                        }
                        @if (a.Files.Any())
                        {
                            <div class="ad-files-title">@Localizer["AttachedFilesLabel"]</div>
                            @foreach (var f in a.Files)
                            {
                                <div class="ad-file-row">
                                    <i class="bi bi-paperclip"></i>
                                    <span class="ad-file-name">@f.Name</span>
                                    <a href="@f.ViewUrl" target="_blank" class="ad-file-link"><i class="bi bi-eye"></i> @Localizer["View"]</a>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Ժամկետներ -->
        <div class="ca-section-card">
            <div class="ca-section-head">
                <span class="ca-section-num">1</span>
                <h2 class="ca-section-title">@Localizer["AssignmentStartLabel"] / @Localizer["AssignmentDueLabel"]</h2>
            </div>
            <div class="ca-section-body">
                <div class="ca-field-row">
                    <div class="ca-field">
                        <label class="ca-label">@Localizer["AssignmentStartLabel"] <span class="ca-required">*</span></label>
                        <input type="datetime-local" name="StartDate" class="ca-input" value="@Model.StartDate" required />
                    </div>
                    <div class="ca-field">
                        <label class="ca-label">@Localizer["AssignmentDueLabel"] <span class="ca-required">*</span></label>
                        <input type="datetime-local" name="DueDate" class="ca-input" value="@Model.DueDate" required />
                    </div>
                </div>
            </div>
        </div>

        <!-- Սովորողների ընտրություն -->
        <div class="ca-section-card">
            <div class="ca-section-head">
                <span class="ca-section-num">2</span>
                <h2 class="ca-section-title">@Localizer["SendToStudentsSection"]</h2>
            </div>
            <div class="ca-section-body">
                <partial name="Form/_PupilPicker" model="pupilPicker" />
            </div>
        </div>

    </div>@* /ca-container *@

    <div class="ca-footer">
        <a href="@Model.CancelUrl" class="ca-cancel-btn">@Localizer["CancelBtn"]</a>
        <button type="submit" class="ca-submit-btn" id="caSubmitBtn" disabled>
            <i class="bi bi-plus-lg"></i> @Localizer["SendAssignmentBtn"]
        </button>
    </div>
</form>

<!-- Հաստատման պատուհան՝ ուղարկելուց առաջ -->
<div class="ca-confirm-backdrop" id="caConfirmBackdrop"></div>
<div class="ca-confirm-modal" id="caConfirmModal" role="dialog" aria-modal="true" aria-labelledby="caConfirmTitle">
    <div class="ca-confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
    <h3 class="ca-confirm-title" id="caConfirmTitle">@Localizer["ConfirmSendTitle"]</h3>
    <p class="ca-confirm-text">@Localizer["ConfirmSendText"]</p>
    <div class="ca-confirm-actions">
        <button type="button" class="ca-cancel-btn" id="caConfirmCancel">@Localizer["CancelBtn"]</button>
        <button type="button" class="ca-submit-btn" id="caConfirmOk"><i class="bi bi-send"></i> @Localizer["ConfirmSendBtn"]</button>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/assignments/assignment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assignments/create-assignment.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/assignments/group-picker.js" asp-append-version="true"></script>
    <script src="~/js/assignments/pupil-picker.js" asp-append-version="true"></script>
    <script src="~/js/assignments/create-assignment.js" asp-append-version="true"></script>
}
