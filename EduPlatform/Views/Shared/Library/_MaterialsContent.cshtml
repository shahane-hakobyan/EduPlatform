@model EduPlatform.ViewModels.Library.MaterialsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

@{
    var uid = Guid.NewGuid().ToString("N")[..6];
}

<div class="materials-content">
<div class="materials-filter-label">@Localizer["Filters"]</div>
<div class="materials-filter-bar">
    <div class="materials-search position-relative">
        <i class="bi bi-search materials-search-icon"></i>
        <input type="text" class="materials-search-input materials-search-input-full" placeholder="@Localizer["Search"]" />
    </div>
    <div class="materials-filter-row d-flex flex-wrap align-items-center gap-2">
        @foreach (var filter in Model.Filters)
        {
            <div class="dropdown materials-filter-dropdown" data-filter-key="@filter.Key">
                <button class="btn materials-filter-select dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    @filter.Label
                    <span class="materials-filter-badge" style="display:none">0</span>
                </button>
                <div class="dropdown-menu materials-filter-menu">
                    <div class="materials-filter-menu-head">
                        <a href="#" class="materials-filter-clear-one" style="display:none">
                            <i class="bi bi-x-circle"></i> @Localizer["ClearThisFilter"]
                        </a>
                    </div>
                    @for (var i = 0; i < filter.Options.Count; i++)
                    {
                        var inputId = $"f-{uid}-{filter.Key}-{i}";
                        <input type="checkbox" class="materials-filter-pill-input" value="@filter.Options[i]" id="@inputId" />
                        <label class="materials-filter-pill" for="@inputId">@filter.Options[i]</label>
                    }
                </div>
            </div>
        }
        <button type="button" class="materials-filter-apply-btn">@Localizer["Apply"]</button>
        <a href="#" class="materials-filter-clear-btn" style="display:none">
            <i class="bi bi-x-circle"></i> @Localizer["ClearFilters"]
        </a>
    </div>
</div>

<div class="d-flex justify-content-end mb-3 mt-3">
    <div class="materials-view-toggle btn-group" role="group">
        <button type="button" class="btn materials-view-btn active" data-view="grid">
            <i class="bi bi-grid-3x3-gap"></i> @Localizer["Grid"]
        </button>
        <button type="button" class="btn materials-view-btn" data-view="list">
            <i class="bi bi-list-ul"></i> @Localizer["ListView"]
        </button>
    </div>
</div>

<div class="materials-grid">
    @foreach (var material in Model.Materials)
    {
        <partial name="_MaterialCard" model="material" />
    }
</div>

<div class="materials-list-view" style="display:none;">
    <table class="materials-table">
        <thead>
            <tr>
                <th>@Localizer["Material"]</th>
                @if (Model.Filters.Any(f => f.Key == "subject"))
                {
                    <th>@Localizer["Subject"]</th>
                }
                <th>@Localizer["Author"]</th>
                @if (Model.Filters.Any(f => f.Key == "grade"))
                {
                    <th>@Localizer["Grade"]</th>
                }
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var material in Model.Materials)
            {
                <tr data-saved-key="@material.MaterialType-@material.Id"
                    data-f-subject="@string.Join("|", material.Subjects)"
                    data-f-grade="@string.Join("|", material.Grades)"
                    data-f-author="@string.Join("|", material.Authors.Split(", ", StringSplitOptions.RemoveEmptyEntries))"
                    data-f-year="@material.Year"
                    data-f-publisher="@material.Publisher"
                    data-f-language="@material.Language"
                    data-f-type="@material.TypeLabel"
                    data-f-status="@material.StatusLabel"
                    data-f-search="@((material.Title + " " + material.Authors + " " + material.Publisher).ToLowerInvariant())">
                    <td data-label="@Localizer["Material"]">
                        <div class="d-flex align-items-center gap-3">
                            <div class="materials-table-icon cover-@material.ColorVariant">
                                @if (!string.IsNullOrEmpty(material.ThumbnailUrl))
                                {
                                    <img src="@material.ThumbnailUrl" alt="@material.Title" loading="lazy" decoding="async" />
                                }
                                else
                                {

                                    <i class="bi bi-tablet"></i>
                                }
                            </div>
                            <div>
                                <div class="materials-table-title">
                                    @material.Title
                                    @if (material.IsArchived)
                                    {
                                        <i class="bi bi-archive-fill materials-table-archived" data-bs-toggle="tooltip" title="@Localizer["StatusArchived"]"></i>
                                    }
                                </div>
                                @{
                                    var sub = new List<string>();
                                    if (material.Year.HasValue) sub.Add(material.Year.Value.ToString());
                                    if (material.Pages > 0) sub.Add($"{material.Pages} {Localizer["Pages"]}");
                                }
                                @if (sub.Count > 0)
                                {
                                    <div class="materials-table-sub">@string.Join(" · ", sub)</div>
                                }
                            </div>
                        </div>
                    </td>
                    @if (Model.Filters.Any(f => f.Key == "subject"))
                    {
                        <td data-label="@Localizer["Subject"]"><span class="materials-table-chip">@string.Join(", ", material.Subjects)</span></td>
                    }
                    <td data-label="@Localizer["Author"]" class="materials-table-author">@material.Authors</td>
                    @if (Model.Filters.Any(f => f.Key == "grade"))
                    {
                        <td data-label="@Localizer["Grade"]">@string.Join(", ", material.Grades)</td>
                    }
                    <td data-label="@Localizer["Actions"]">
                        <div class="materials-table-actions d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(material.ViewUrl))
                            {
                                <a href="@material.ViewUrl" class="material-card-view-btn d-flex align-items-center justify-content-center gap-2" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-eye"></i> @Localizer["View"]
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(material.DownloadUrl))
                            {
                                <a href="@material.DownloadUrl" download class="material-card-download-btn d-flex align-items-center justify-content-center">
                                    <i class="bi bi-download"></i>
                                </a>
                            }
                            <button type="button" class="material-card-delete-btn d-flex align-items-center justify-content-center" data-type="@material.MaterialType" data-id="@material.Id" data-confirm-text="@Localizer["ConfirmDeleteMaterial"]" title="@Localizer["Remove"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Դատարկ վիճակները՝ միշտ նկարվում են, ցույց/թաքցնում է materials.js-ը *@
<div class="materials-empty text-center py-5" data-empty="none" style="@(Model.Materials.Any() ? "display:none" : "")">
    <i class="bi bi-inbox materials-empty-icon"></i>
    <p class="materials-empty-text">@Localizer["NoMaterialsSaved"]</p>
</div>
<div class="materials-empty text-center py-5" data-empty="filtered" style="display:none">
    <i class="bi bi-funnel materials-empty-icon"></i>
    <p class="materials-empty-text">@Localizer["NoMaterialsMatchFilters"]</p>
</div>
</div>
