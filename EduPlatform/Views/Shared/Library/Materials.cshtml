@model EduPlatform.ViewModels.Library.MaterialsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Model.Title;
}

<div class="materials-header d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="materials-header-icon d-flex align-items-center justify-content-center">
            <i class="bi bi-book"></i>
        </div>
        <h1 class="materials-title mb-0">@Model.Title</h1>
    </div>
    <div class="materials-count-badge text-center">
        <div class="materials-count-label">@Localizer["Total"]</div>
        <div class="materials-count-value">@Model.TotalCount</div>
    </div>
</div>

<partial name="_MaterialsContent" model="Model" />

<div id="materialImagePreview" class="material-image-preview"></div>

@section Styles {
    <link rel="stylesheet" href="~/css/library/materials.css" />
    <link rel="stylesheet" href="~/css/common/filter-bar.css" />
}
@section Scripts {
    <script src="~/js/common/filter-bar.js"></script>
    <script src="~/js/library/materials.js"></script>
}
