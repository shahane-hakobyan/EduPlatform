@model List<EduPlatform.ViewModels.Library.OtherBooksTabViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["OtherBooks"].Value;
}

<div class="materials-header d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="materials-header-icon d-flex align-items-center justify-content-center">
            <i class="bi bi-collection"></i>
        </div>
        <h1 class="materials-title mb-0">@Localizer["OtherBooks"]</h1>
    </div>
</div>

<div class="library-tabs-card mb-3">
    <div class="library-tabs-row">
        @for (int i = 0; i < Model.Count; i++)
        {
            var tab = Model[i];
            var icon = tab.Key switch
            {
                "other-textbooks" => "bi-book",
                "fiction" => "bi-book-half",
                _ => "bi-collection"
            };
            <button type="button" class="library-tab-btn @(i == 0 ? "active" : "")" data-tab-target="library-tab-@tab.Key" data-count="@tab.Content.TotalCount">
                <i class="bi @icon"></i> @tab.Content.Title
            </button>
        }
    </div>
    <div class="library-tabs-count-row">
        <span class="library-tabs-count-label">@Localizer["Total"]</span>
        <span class="library-tabs-count-badge" id="libraryTabCount">@Model[0].Content.TotalCount</span>
    </div>
</div>

@for (int i = 0; i < Model.Count; i++)
{
    var tab = Model[i];
    <div class="library-tab-pane @(i == 0 ? "active" : "")" id="library-tab-@tab.Key" style="@(i == 0 ? "" : "display:none;")">
        <partial name="~/Views/Shared/Materials/_MaterialsContent.cshtml" model="tab.Content" />
    </div>
}

<div id="materialImagePreview" class="material-image-preview"></div>

@section Styles {
    <link rel="stylesheet" href="~/css/materials.css" />
}
@section Scripts {
    <script src="~/js/library.js"></script>
}