@model EduPlatform.ViewModels.PupilSubmissionViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div id="answerModal-@Model.Id-backdrop" class="answer-modal-backdrop"></div>
<div id="answerModal-@Model.Id" class="answer-modal" data-submission-id="@Model.Id">
    <div class="answer-modal-header">
        <div class="d-flex align-items-center gap-3">
            <img src="@Model.PhotoUrl" alt="" class="answer-modal-avatar" />
            <div>
                <div class="answer-modal-name">@Model.PupilName</div>
                <div class="answer-modal-meta">@Model.GradeName &middot; @Model.GroupName &middot; @(Model.SubmittedDate?.ToString("dd.MM.yyyy"))</div>
            </div>
        </div>
        <button type="button" class="answer-modal-close" data-close-modal="answerModal-@Model.Id">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="answer-modal-body">
        <div class="answer-modal-section">
            <div class="answer-modal-label">@Localizer["FileAnswerOption"]</div>
            <div class="answer-attachment-row">
                <div class="answer-attachment-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="answer-attachment-name">@Model.AttachmentFileName</div>
                <a href="@Model.AttachmentUrl" target="_blank" class="answer-attachment-btn"><i class="bi bi-eye"></i> @Localizer["View"]</a>
                <a href="@Model.AttachmentUrl" download class="answer-attachment-btn answer-attachment-btn-primary"><i class="bi bi-download"></i> @Localizer["DownloadLabel"]</a>
            </div>
        </div>

        <div class="answer-modal-section answer-modal-section-bordered">
            <div class="answer-modal-label-lg">@Localizer["Evaluation"]</div>
            <div class="answer-grading-tabs" data-grading-tabs>
                <button type="button" class="answer-grading-tab @(Model.GradingMode == "Point" ? "active" : "")" data-mode="Point">@Localizer["PointGrading"]</button>
                <button type="button" class="answer-grading-tab @(Model.GradingMode == "Formative" ? "active" : "")" data-mode="Formative">@Localizer["FormativeGrading"]</button>
            </div>

            <div class="answer-grading-panel" data-panel="Point" style="display:@(Model.GradingMode == "Point" ? "block" : "none")">
                <div class="answer-modal-label mb-2">@Localizer["PointsRangeLabel"]</div>
                <div class="answer-points-grid">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="answer-point-btn @(Model.Score == i ? "active" : "")" data-score="@i">@i</button>
                    }
                </div>
                <div class="answer-warning-note mt-3">
                    <i class="bi bi-exclamation-triangle"></i> @Localizer["PointGradeVisibilityNote"]
                </div>
            </div>

            <div class="answer-grading-panel" data-panel="Formative" style="display:@(Model.GradingMode == "Formative" ? "block" : "none")">
                <div class="answer-modal-label mb-2">@Localizer["ProtocolLabel"]</div>
                <textarea class="answer-protocol-textarea" rows="4" placeholder="@Localizer["ProtocolPlaceholder"]">@Model.ProtocolText</textarea>
                <div class="answer-info-note mt-2">
                    <i class="bi bi-info-circle"></i> @Localizer["FormativeGradeVisibilityNote"]
                </div>
            </div>
        </div>
    </div>

    <div class="answer-modal-footer">
        <button type="button" class="answer-cancel-btn" data-close-modal="answerModal-@Model.Id">@Localizer["CancelBtn"]</button>
        <button type="button" class="answer-save-btn" data-save-grade data-submission-id="@Model.Id">
            <i class="bi bi-check-lg"></i> @Localizer["SaveGradeBtn"]
        </button>
    </div>
</div>