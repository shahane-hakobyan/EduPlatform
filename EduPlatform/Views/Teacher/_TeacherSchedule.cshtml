@model EduPlatform.ViewModels.ScheduleReadViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    var current = Model.Days.First(d => d.IsSelected);
}

<div class="schedule-card" id="teacherScheduleCard">
    <div class="schedule-header d-flex align-items-center justify-content-between">
        <div>
            <h2 class="schedule-title mb-0">@Localizer["Schedule"]</h2>
            <p class="schedule-subtitle mb-0">@Localizer["ScheduleSubtitle"]</p>
        </div>
        <button type="button" id="scheduleEditOpenBtn" class="schedule-edit-btn" data-day="@current.Day">
            <i class="bi bi-pencil-fill"></i> @Localizer["Edit"]
        </button>
    </div>

    <div class="schedule-body d-flex gap-3 mt-3">
        <div class="schedule-main flex-grow-1">
            <div class="schedule-current-day-row d-flex align-items-center gap-3">
                <div class="schedule-current-day-name">
                    <span class="schedule-current-day-accent"></span>
                    @current.DayLabel
                </div>
                <span class="schedule-current-day-meta-badge">
                    <i class="bi bi-clock"></i> @current.ClassCount @Localizer["Classes"] : @current.FreeCount @Localizer["Free"]
                </span>
            </div>

            <div class="schedule-grid mt-3">
                @foreach (var entry in Model.SelectedDayEntries)
                {
                    if (entry.IsFree)
                    {
                        <div class="schedule-card-item schedule-card-free">
                            <div class="schedule-card-top d-flex align-items-center gap-2">
                                <span class="schedule-period-badge schedule-period-badge-free">
                                    <i class="bi bi-cup-hot-fill"></i>
                                </span>
                                <span class="schedule-time-badge">@entry.TimeRange</span>
                            </div>
                            <div class="schedule-free-text">@Localizer["FreePeriod"]</div>
                            <div class="schedule-free-sub">@Localizer["Period"] @entry.PeriodNumber</div>

                            @if (!string.IsNullOrEmpty(entry.Notes))
                            {
                                <span class="schedule-card-note-bubble" data-bs-toggle="tooltip" data-bs-placement="top" title="@entry.Notes">
                                    <i class="bi bi-chat-square-fill"></i>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="schedule-card-item">
                            <div class="schedule-card-icon-badge">@entry.PeriodNumber</div>
                            <div class="schedule-card-content">
                                <div class="schedule-card-badges">
                                    <span class="schedule-card-time-pill">@entry.TimeRange</span>
                                    @if (!string.IsNullOrEmpty(entry.RoomNumber))
                                    {
                                        <span class="schedule-card-room-pill">@Localizer["Room"] @entry.RoomNumber</span>
                                    }
                                </div>
                                <div class="schedule-card-class-name">@entry.ClassName</div>
                                <div class="schedule-card-subject-name">@entry.SubjectName</div>
                            </div>

                            @if (!string.IsNullOrEmpty(entry.Notes))
                            {
                                <span class="schedule-card-note-bubble" data-bs-toggle="tooltip" data-bs-placement="top" title="@entry.Notes">
                                    <i class="bi bi-chat-square-fill"></i>
                                </span>
                            }
                        </div>
                    }
                }

                @if (!Model.SelectedDayEntries.Any())
                {
                    <div class="schedule-empty text-center py-5">
                        <i class="bi bi-calendar-x schedule-empty-icon"></i>
                        <p class="schedule-empty-text">@Localizer["NoScheduleForDay"]</p>
                    </div>
                }
            </div>
        </div>

        <div class="schedule-week-panel flex-shrink-0">
            <div class="schedule-week-header d-flex align-items-center gap-2">
                <i class="bi bi-calendar3"></i>
                <span>@Localizer["WeekDays"]</span>
            </div>
            <div class="schedule-week-list">
                @foreach (var day in Model.Days)
                {
                    <button type="button" class="schedule-week-row @(day.IsSelected ? "selected" : "")" data-day="@day.Day">
                        <div class="schedule-week-row-top d-flex align-items-center justify-content-between">
                            <span class="schedule-week-row-name">@day.DayLabel</span>
                            <span class="d-flex gap-1">
                                <span class="schedule-badge schedule-badge-purple">@day.ClassCount</span>
                                <span class="schedule-badge schedule-badge-green">@day.FreeCount</span>
                            </span>
                        </div>
                        <div class="schedule-week-row-meta">@day.ClassCount @Localizer["Classes"] · @day.FreeCount @Localizer["Free"]</div>
                    </button>
                }
            </div>
            <div class="schedule-week-footer">
                <div class="schedule-week-footer-row d-flex justify-content-between">
                    <span>@Localizer["TotalClasses"]</span>
                    <strong>@Model.TotalClassCount</strong>
                </div>
                <div class="schedule-week-footer-row d-flex justify-content-between">
                    <span>@Localizer["FreeHours"]</span>
                    <strong>@Model.TotalFreeCount</strong>
                </div>
            </div>
        </div>
    </div>
</div>