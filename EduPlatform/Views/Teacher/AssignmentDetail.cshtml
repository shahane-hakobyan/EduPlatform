@model EduPlatform.ViewModels.AssignmentDetailViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Model.Title;
}

<div class="ad-topbar d-flex align-items-center gap-3 mb-3">
    <a href="@Url.Action(nameof(EduPlatform.Controllers.TeacherController.Repository), new { id = "Assignments" })" class="ad-back-btn d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <h1 class="ad-title mb-0">@Model.Title</h1>
        <p class="ad-subtitle mb-0">@Model.Subject &middot; @Model.Grade</p>
    </div>
    <a href="@Model.ArchiveUrl" class="ad-archive-btn d-flex align-items-center gap-2">
        <i class="bi bi-archive"></i> @Localizer["ArchiveAssignment"]
    </a>
</div>

<div class="ad-card mb-3">
    <div class="ad-card-head">
        <i class="bi bi-file-earmark-text"></i>
        <h2 class="ad-card-title">@Localizer["AssignmentDetailsSection"]</h2>
    </div>
    <div class="ad-card-body">
        <div class="ad-info-grid">
            <div>
                <div class="ad-info-label">@Localizer["AssignmentType"]</div>
                <div class="ad-info-value">@Model.Type</div>
            </div>
            <div>
                <div class="ad-info-label">@Localizer["Evaluation"]</div>
                <div class="ad-info-value">@Model.GradingType</div>
            </div>
            <div>
                <div class="ad-info-label">@Localizer["AssignmentStartLabel"]</div>
                <div class="ad-info-value">@Model.StartDate.ToString("dd.MM.yyyy")</div>
            </div>
            <div>
                <div class="ad-info-label">@Localizer["AssignmentDueLabel"]</div>
                <input type="date" class="ad-due-input" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="ad-description-box mt-3">@Model.Description</div>
    </div>
</div>

<div class="ad-card">
    <div class="ad-card-head justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-people"></i>
            <h2 class="ad-card-title">@Localizer["SendToStudentsSection"]</h2>
        </div>
        <button type="button" class="ad-add-btn" data-open-modal="addPupilsModal"><i class="bi bi-person-plus"></i> @Localizer["AddLabel"]</button>
    </div>

    <div class="ad-filter-bar">
        <div class="ad-search position-relative">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="@Localizer["SearchPupilByNamePlaceholder"]" />
        </div>
        <select class="ad-filter-select"><option>@Localizer["Grade"]</option></select>
        <select class="ad-filter-select"><option>@Localizer["GroupLabel"]</option></select>
        <select class="ad-filter-select"><option>@Localizer["StatusLabel"]</option></select>
    </div>

    <div class="ad-submission-list">
        @foreach (var s in Model.Submissions)
        {
            var badgeClass = s.Status switch { "Graded" => "ad-badge-graded", "Submitted" => "ad-badge-submitted", _ => "ad-badge-pending" };
            var badgeLabel = s.Status switch { "Graded" => Localizer["SubmissionStatusGraded"], "Submitted" => Localizer["SubmissionStatusSubmitted"], _ => Localizer["SubmissionStatusPending"] };

            <div class="ad-submission-row">
                <img src="@s.PhotoUrl" alt="" class="ad-submission-avatar" />
                <div class="ad-submission-info">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ad-submission-name">@s.PupilName</span>
                        <span class="ad-badge @badgeClass">@badgeLabel</span>
                    </div>
                    <div class="ad-submission-meta">
                        @s.GradeName &middot; @Localizer["GroupLabel"] @s.GroupName
                        @if (s.SubmittedDate.HasValue)
                        {
                            <text> &middot; @Localizer["SubmittedOn"] @s.SubmittedDate.Value.ToString("dd.MM.yyyy")</text>
                        }
                    </div>
                    @if (s.Status == "Graded" && s.Score.HasValue)
                    {
                        <div class="ad-submission-score">
                            <i class="bi bi-star-fill"></i>
                            <span class="ad-score-value">@s.Score/@s.MaxScore</span>
                            @if (!string.IsNullOrEmpty(s.ScoreFeedback))
                            {
                                <span class="ad-score-feedback">&middot; @s.ScoreFeedback</span>
                            }
                        </div>
                    }
                </div>
                <div class="ad-submission-actions">
                    <button type="button" class="ad-view-btn" data-open-modal="answerModal-@s.Id">
                        <i class="bi bi-eye"></i> @Localizer["View"]
                    </button>
                    <button type="button" class="ad-grade-btn" data-open-modal="answerModal-@s.Id">
                        <i class="bi bi-star"></i> @Localizer["GradeLabel"]
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@foreach (var s in Model.Submissions)
{
    <partial name="_AnswerModal" model="s" />
}
<partial name="_AddPupilsModal" model="Model" />
@section Styles {
    <link rel="stylesheet" href="~/css/assignment-detail.css" />
    <link rel="stylesheet" href="~/css/create-assignment.css" />
}
@section Scripts {
    <script src="~/js/assignment-detail.js" data-assignment-id="@Model.Id"></script>
}