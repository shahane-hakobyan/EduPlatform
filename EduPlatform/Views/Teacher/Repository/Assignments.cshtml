@model EduPlatform.ViewModels.AssignmentsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Assignments"].Value;
}

<div class="assignments-header d-flex align-items-start justify-content-between mb-3">
    <div>
        <h1 class="materials-title mb-1">@Localizer["ViewAssignments"]</h1>
        <p class="tools-subtitle mb-0">
            @Model.Active.Count @Localizer["ActiveLabel"] &middot; @Model.Archived.Count @Localizer["ArchivedLabel"]
        </p>
    </div>
    <a href="@Model.CreateUrl" class="assignments-create-btn d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> @Localizer["CreateAssignment"]
    </a>
</div>

<div class="assignments-tabs-row mb-3">
    <button type="button" class="assignment-tab-btn active" data-tab-target="assignments-tab-active">
        @Localizer["CurrentAssignments"] <span class="assignment-tab-count">@Model.Active.Count</span>
    </button>
    <button type="button" class="assignment-tab-btn" data-tab-target="assignments-tab-archived">
        @Localizer["ArchivedAssignments"] <span class="assignment-tab-count">@Model.Archived.Count</span>
    </button>
</div>

@{
    var subjects = Model.Assignments.Select(a => a.Subject).Distinct().ToList();
    var grades = Model.Assignments.Select(a => a.Grade).Distinct().ToList();
    var types = Model.Assignments.Select(a => a.Type).Distinct().ToList();
    var gradingTypes = Model.Assignments.Select(a => a.GradingType).Distinct().ToList();
}

<div class="assignments-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="materials-search position-relative flex-grow-1">
        <i class="bi bi-search materials-search-icon"></i>
        <input type="text" class="materials-search-input" placeholder="@Localizer["SearchAssignments"]" />
    </div>
    <select class="materials-filter-select" data-filter-key="subject">
        <option value="">@Localizer["Subject"]</option>
        @foreach (var s in subjects)
        {
            <option value="@s">@s</option>
        }
    </select>
    <select class="materials-filter-select" data-filter-key="grade">
        <option value="">@Localizer["Grade"]</option>
        @foreach (var g in grades)
        {
            <option value="@g">@g</option>
        }
    </select>
    <select class="materials-filter-select" data-filter-key="type">
        <option value="">@Localizer["AssignmentType"]</option>
        @foreach (var t in types)
        {
            <option value="@t">@t</option>
        }
    </select>
    <select class="materials-filter-select" data-filter-key="gradingType">
        <option value="">@Localizer["Evaluation"]</option>
        @foreach (var g in gradingTypes)
        {
            <option value="@g">@g</option>
        }
    </select>
    <input type="date" class="assignments-date-input" placeholder="@Localizer["DueDate"]" />
    <span class="assignments-result-count ms-auto" id="assignmentsResultCount">
        @Model.Assignments.Count @Localizer["AssignmentsCountSuffix"]
    </span>
</div>

<div id="assignments-tab-active" class="assignment-tab-pane active">
    @if (!Model.Active.Any())
    {
        <div class="materials-empty text-center py-5">
            <i class="bi bi-inbox materials-empty-icon"></i>
            <p class="materials-empty-text">@Localizer["NoAssignments"]</p>
        </div>
    }
    else
    {
        <div class="assignments-grid">
            @foreach (var a in Model.Active)
            {
                <partial name="~/Views/Teacher/_AssignmentCard.cshtml" model="a" />
            }
        </div>
    }
</div>

<div id="assignments-tab-archived" class="assignment-tab-pane" style="display:none;">
    @if (!Model.Archived.Any())
    {
        <div class="materials-empty text-center py-5">
            <i class="bi bi-archive materials-empty-icon"></i>
            <p class="materials-empty-text">@Localizer["NoArchivedAssignments"]</p>
        </div>
    }
    else
    {
        <div class="assignments-grid">
            @foreach (var a in Model.Archived)
            {
                <partial name="~/Views/Teacher/_AssignmentCard.cshtml" model="a" />
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/materials.css" />
    <link rel="stylesheet" href="~/css/assignments.css" />
}
@section Scripts {
    <script src="~/js/assignments.js"></script>
}