@model EduPlatform.ViewModels.CreatedMaterialsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["MyCreatedMaterials"].Value;
}

<div class="cm-toolbar">
    <div class="cm-search">
        <i class="bi bi-search cm-search-icon"></i>
        <input type="text" id="cmSearchInput" class="cm-search-input" placeholder="@Localizer["SearchByTitle"]" />
    </div>

    <div class="cm-filters">
        <select class="cm-filter-select"><option>@Localizer["Subject"]</option></select>
        <select class="cm-filter-select"><option>@Localizer["Grade"]</option></select>
        <select class="cm-filter-select"><option>@Localizer["Date"]</option></select>
        <select class="cm-filter-select"><option>@Localizer["Views"]</option></select>
        <select class="cm-filter-select"><option>@Localizer["Type"]</option></select>
    </div>

    <div class="materials-view-toggle d-flex align-items-center" role="group" aria-label="@Localizer["View"]">
        <button type="button" class="materials-view-btn active d-inline-flex align-items-center gap-1" data-view="grid" onclick="cmSwitchView('grid', this)">
            <i class="bi bi-grid-3x3-gap"></i> @Localizer["GridView"]
        </button>
        <button type="button" class="materials-view-btn d-inline-flex align-items-center gap-1" data-view="list" onclick="cmSwitchView('list', this)">
            <i class="bi bi-list-ul"></i> @Localizer["ListView"]
        </button>
    </div>
</div>

@if (!Model.Materials.Any())
{
    <div class="materials-empty text-center py-5">
        <i class="bi bi-inbox materials-empty-icon"></i>
        <p class="materials-empty-text">@Localizer["NoMaterialsSaved"]</p>
    </div>
}
else
{
    <div id="cmGridView" class="materials-grid cm-grid">
        @foreach (var m in Model.Materials)
        {
            <div class="cm-card" data-cm-title="@m.Title.ToLowerInvariant()">
                <div class="cm-card-head">
                    <div class="cm-card-icon tint-@m.ColorVariant">
                        <i class="bi @m.IconClass"></i>
                    </div>
                    <div class="cm-card-headtext">
                        <div class="cm-card-title">@m.Title</div>
                        <div class="cm-card-subject">@m.Subject</div>
                        <div class="cm-card-date">@m.Date.ToString("dd.MM.yyyy")</div>
                    </div>
                </div>
                <div class="cm-card-badges">
                    <span class="cm-badge cm-badge-type">@m.Type</span>
                    <span class="cm-badge cm-badge-grade">@m.Grade</span>
                    <span class="cm-badge cm-badge-status">@m.Status</span>
                </div>
                <p class="cm-card-desc">@m.Description</p>
                <div class="cm-card-actions">
                    <a class="cm-action-btn" href="@m.EditUrl" title="@Localizer["Edit"]"><i class="bi bi-pencil-square"></i></a>
                    <a class="cm-action-btn" href="@m.DownloadUrl" title="@Localizer["Download"]"><i class="bi bi-download"></i></a>
                    <button type="button" class="cm-action-btn" title="@Localizer["Share"]"><i class="bi bi-share"></i></button>
                    <button type="button" class="cm-action-btn" title="@Localizer["Duplicate"]"><i class="bi bi-clipboard-plus"></i></button>
                    <button type="button" class="cm-action-btn" title="@Localizer["SendMaterial"]"><i class="bi bi-send"></i></button>
                    <button type="button" class="cm-action-btn" title="@Localizer["Statistics"]"><i class="bi bi-bar-chart"></i></button>
                    <button type="button" class="cm-action-btn cm-action-danger" title="@Localizer["Delete"]"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        }
    </div>

    <div id="cmListView" class="cm-table-wrap" hidden>
        <table class="cm-table">
            <thead>
                <tr>
                    <th>@Localizer["MaterialTitle"]</th>
                    <th>@Localizer["Subject"]</th>
                    <th>@Localizer["Grade"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Type"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Materials)
                {
                    <tr data-cm-title="@m.Title.ToLowerInvariant()">
                        <td>
                            <span class="cm-row-dot"></span>
                            <span class="cm-row-title">@m.Title</span>
                        </td>
                        <td>@m.Subject</td>
                        <td>@m.Grade</td>
                        <td>@m.Date.ToString("dd.MM.yyyy")</td>
                        <td>@m.Type</td>
                        <td>@m.Status</td>
                        <td>
                            <div class="cm-row-actions">
                                <a href="@m.EditUrl" title="@Localizer["Edit"]"><i class="bi bi-pencil-square"></i></a>
                                <a href="@m.DownloadUrl" title="@Localizer["Download"]"><i class="bi bi-download"></i></a>
                                <button type="button" title="@Localizer["Share"]"><i class="bi bi-share"></i></button>
                                <button type="button" title="@Localizer["Duplicate"]"><i class="bi bi-clipboard-plus"></i></button>
                                <button type="button" title="@Localizer["SendMaterial"]"><i class="bi bi-send"></i></button>
                                <button type="button" title="@Localizer["Statistics"]"><i class="bi bi-bar-chart"></i></button>
                                <button type="button" class="cm-row-danger" title="@Localizer["Delete"]"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/materials.css" />
    <link rel="stylesheet" href="~/css/tools.css" />
    <link rel="stylesheet" href="~/css/created-materials.css" />
}

@section Scripts {
    <script>
        function cmSwitchView(view, btn) {
            document.querySelectorAll('.materials-view-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('cmGridView').hidden = view !== 'grid';
            document.getElementById('cmListView').hidden = view !== 'list';
        }

        document.getElementById('cmSearchInput')?.addEventListener('input', function() {
            const q = this.value.trim().toLowerCase();
            document.querySelectorAll('#cmGridView .cm-card').forEach(card => {
                card.hidden = !card.dataset.cmTitle.includes(q);
            });
            document.querySelectorAll('#cmListView tbody tr').forEach(row => {
                row.hidden = !row.dataset.cmTitle.includes(q);
            });
        });
    </script>
}