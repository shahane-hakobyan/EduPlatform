@model EduPlatform.ViewModels.ScheduleEditViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EduPlatform.Resources.SharedResource> Localizer

<div id="scheduleEditBackdrop" class="edit-profile-backdrop"></div>
<div id="scheduleEditModal" class="schedule-edit-panel">
    <div class="schedule-edit-header">
        <div class="schedule-edit-header-left">
            <span class="schedule-edit-icon"><i class="bi bi-pencil-fill"></i></span>
            <div>
                <h2 class="schedule-edit-title mb-0">@Localizer["ScheduleEditTitle"]</h2>
                <p class="schedule-edit-subtitle mb-0">@Model.DayLabel</p>
            </div>
        </div>
        <button type="button" id="scheduleEditCloseBtn" class="schedule-edit-close-btn" aria-label="@Localizer["Close"]">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <p class="schedule-edit-hint">@Localizer["ScheduleEditHint"]</p>

    <form id="scheduleEditForm" data-day="@Model.Day" class="schedule-edit-form">
        <div id="scheduleEditRows" class="schedule-edit-rows">
            @for (int i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                <div class="schedule-edit-row @(row.IsFree ? "is-free" : "")" data-period="@row.PeriodNumber">
                    <div class="schedule-edit-row-top d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="schedule-edit-period-badge">@row.PeriodNumber</span>
                            <div class="time-range-picker">
                                <input type="hidden" class="schedule-edit-start-time" value="@row.StartTime" />
                                <input type="hidden" class="schedule-edit-end-time" value="@row.EndTime" />
                                <button type="button" class="time-picker-display">
                                    <span class="time-picker-text">@Localizer["SelectTime"]</span>
                                    <i class="bi bi-clock"></i>
                                </button>
                                <div class="time-picker-dropdown">
                                    <div class="time-picker-steppers">
                                        <div class="time-picker-col">
                                            <button type="button" class="time-picker-arrow time-picker-hour-up"><i class="bi bi-chevron-up"></i></button>
                                            <div class="time-picker-value-display time-picker-hour-display">09</div>
                                            <button type="button" class="time-picker-arrow time-picker-hour-down"><i class="bi bi-chevron-down"></i></button>
                                        </div>
                                        <div class="time-picker-colon">:</div>
                                        <div class="time-picker-col">
                                            <button type="button" class="time-picker-arrow time-picker-minute-up"><i class="bi bi-chevron-up"></i></button>
                                            <div class="time-picker-value-display time-picker-minute-display">00</div>
                                            <button type="button" class="time-picker-arrow time-picker-minute-down"><i class="bi bi-chevron-down"></i></button>
                                        </div>
                                    </div>
                                    <div class="time-picker-ampm">
                                        <button type="button" class="time-picker-ampm-btn active" data-ampm="AM">AM</button>
                                        <button type="button" class="time-picker-ampm-btn" data-ampm="PM">PM</button>
                                    </div>
                                    <div class="time-range-toggle">
                                        <button type="button" class="time-range-toggle-btn active" data-target="start">@Localizer["Start"]</button>
                                        <button type="button" class="time-range-toggle-btn" data-target="end">@Localizer["End"]</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="schedule-edit-add-class-btn">
                                <i class="bi bi-plus-lg"></i> @Localizer["AddPeriod"]
                            </button>
                            <button type="button" class="schedule-edit-remove-btn">
                                <i class="bi bi-trash"></i> @Localizer["Remove"]
                            </button>
                        </div>
                    </div>

                    <div class="schedule-edit-free-indicator">
                        <i class="bi bi-calendar-week"></i> @Localizer["FreePeriod"]
                    </div>

                    <div class="schedule-edit-fields">
                        <div>
                            <label class="schedule-edit-field-label">@Localizer["Subject"] *</label>
                            <select class="schedule-edit-input schedule-edit-subject-select">
                                <option value="">—</option>
                                @foreach (var s in Model.Subjects)
                                {
                                    <option value="@s.Id" selected="@(s.Id == row.SubjectId)">@s.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="schedule-edit-field-label">@Localizer["Notes"]</label>
                            <input type="text" class="schedule-edit-input schedule-edit-notes-input" value="@row.Notes" placeholder="@Localizer["ScheduleNotesPlaceholder"]" />
                        </div>
                        <div class="d-flex gap-3">
                            <div class="flex-grow-1">
                                <label class="schedule-edit-field-label">@Localizer["Grade"] *</label>
                                <select class="schedule-edit-input schedule-edit-class-select">
                                    <option value="">—</option>
                                    @foreach (var c in Model.Grades)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == row.GradeId)">@c.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="flex-grow-1">
                                <label class="schedule-edit-field-label">@Localizer["Room"]</label>
                                <input type="text" class="schedule-edit-input schedule-edit-room-input" value="@row.RoomNumber" placeholder="@Localizer["Room"]" />
                            </div>
                        </div>
                        <button type="button" class="schedule-edit-make-free-btn">@Localizer["MarkAsFree"]</button>
                    </div>
                </div>
            }

            <div class="schedule-edit-row is-free schedule-edit-row-template" data-period="0" style="display:none;">
                <div class="schedule-edit-row-top d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="schedule-edit-period-badge">0</span>
                        <div class="time-range-picker">
                            <input type="hidden" class="schedule-edit-start-time" value="" />
                            <input type="hidden" class="schedule-edit-end-time" value="" />
                            <button type="button" class="time-picker-display">
                                <span class="time-picker-text">@Localizer["SelectTime"]</span>
                                <i class="bi bi-clock"></i>
                            </button>
                            <div class="time-picker-dropdown">
                                <div class="time-picker-steppers">
                                    <div class="time-picker-col">
                                        <button type="button" class="time-picker-arrow time-picker-hour-up"><i class="bi bi-chevron-up"></i></button>
                                        <div class="time-picker-value-display time-picker-hour-display">09</div>
                                        <button type="button" class="time-picker-arrow time-picker-hour-down"><i class="bi bi-chevron-down"></i></button>
                                    </div>
                                    <div class="time-picker-colon">:</div>
                                    <div class="time-picker-col">
                                        <button type="button" class="time-picker-arrow time-picker-minute-up"><i class="bi bi-chevron-up"></i></button>
                                        <div class="time-picker-value-display time-picker-minute-display">00</div>
                                        <button type="button" class="time-picker-arrow time-picker-minute-down"><i class="bi bi-chevron-down"></i></button>
                                    </div>
                                </div>
                                <div class="time-picker-ampm">
                                    <button type="button" class="time-picker-ampm-btn active" data-ampm="AM">AM</button>
                                    <button type="button" class="time-picker-ampm-btn" data-ampm="PM">PM</button>
                                </div>
                                <div class="time-range-toggle">
                                    <button type="button" class="time-range-toggle-btn active" data-target="start">@Localizer["Start"]</button>
                                    <button type="button" class="time-range-toggle-btn" data-target="end">@Localizer["End"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="schedule-edit-add-class-btn">
                            <i class="bi bi-plus-lg"></i> @Localizer["AddPeriod"]
                        </button>
                        <button type="button" class="schedule-edit-remove-btn">
                            <i class="bi bi-trash"></i> @Localizer["Remove"]
                        </button>
                    </div>
                </div>

                <div class="schedule-edit-free-indicator">
                    <i class="bi bi-calendar-week"></i> @Localizer["FreePeriod"]
                </div>

                <div class="schedule-edit-fields">
                    <div>
                        <label class="schedule-edit-field-label">@Localizer["Subject"] *</label>
                        <select class="schedule-edit-input schedule-edit-subject-select">
                            <option value="">—</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id">@s.Label</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="schedule-edit-field-label">@Localizer["Notes"]</label>
                        <input type="text" class="schedule-edit-input schedule-edit-notes-input" placeholder="@Localizer["ScheduleNotesPlaceholder"]" />
                    </div>
                    <div class="d-flex gap-3">
                        <div class="flex-grow-1">
                            <label class="schedule-edit-field-label">@Localizer["Grade"] *</label>
                            <select class="schedule-edit-input schedule-edit-class-select">
                                <option value="">—</option>
                                @foreach (var c in Model.Grades)
                                {
                                    <option value="@c.Id">@c.Label</option>
                                }
                            </select>
                        </div>
                        <div class="flex-grow-1">
                            <label class="schedule-edit-field-label">@Localizer["Room"]</label>
                            <input type="text" class="schedule-edit-input schedule-edit-room-input" placeholder="@Localizer["Room"]" />
                        </div>
                    </div>
                    <button type="button" class="schedule-edit-make-free-btn">@Localizer["MarkAsFree"]</button>
                </div>
            </div>
        </div>

        <button type="button" id="scheduleAddPeriodBtn" class="schedule-add-period-btn">
            <i class="bi bi-plus-lg"></i> @Localizer["AddPeriod"]
        </button>
    </form>

    <div class="schedule-edit-footer">
        <button type="button" id="scheduleEditCancelBtn" class="schedule-edit-cancel-btn">@Localizer["Cancel"]</button>
        <button type="submit" form="scheduleEditForm" class="schedule-edit-save-btn">
            <i class="bi bi-check-lg"></i> @Localizer["Save"]
        </button>
    </div>
</div>